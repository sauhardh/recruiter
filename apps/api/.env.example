# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/hirefire_db?schema=public"

# Authentication (OAuth & Session)
JWT_SECRET=super_secret_jwt_key_min_32_characters_long_for_security
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Email Configuration (Mandatory for sending notifications to candidates & recruiters)
# Set to 'smtp' for real emails, or 'console' for local terminal logging
EMAIL_PROVIDER=smtp
EMAIL_FROM="HireFire Recruitment <recruitment@yourcompany.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_app_password
